      },
      {
        name: 'ERD — Entity Relationship Diagram',
        path: 'templates/ERD-Entity-Relationship-Diagram.md',
        sections: ['Purpose', 'Mermaid ERD Diagram', 'Relationship Key', 'Notes & Assumptions', 'Revision History'],
