      },
    ],
  },
  {
    heading: 'Clarifications',
    templatePath: 'templates/CLQ-Client-Clarification-Request.md',
    artefactsPath: 'artefacts/client-clarification-requests/',
    description: 'Generated when the sanity check finds blockers. Opt-in after any ❌ finding.',
    templates: [
      {
        name: 'CLQ — Client Clarification Request',
        path: 'templates/CLQ-Client-Clarification-Request.md',
        sections: ['Subject line', 'Opening paragraph', 'One section per blocker (context + question)', 'Next Steps'],
        preview: `# Client Clarification Request (CLQ)

> **Status:** DRAFT | SENT | RESOLVED
