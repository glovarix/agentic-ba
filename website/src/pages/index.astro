---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
const base = import.meta.env.BASE_URL;
---

<Base
  title="Home"
  description="Your AI business analyst — works alongside you to craft requirements, bug reports, and other artefacts verified against your real codebase, right inside your AI powered IDE."
>
  <Hero />

  <!-- 2. Who it's for -->
  <section class="border-t border-zinc-200 bg-zinc-50 py-16 dark:border-zinc-800 dark:bg-zinc-900/50">
    <div class="mx-auto max-w-2xl px-6 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary-200 bg-primary-50 px-3 py-1 text-sm font-semibold uppercase tracking-wide text-primary-700 dark:border-primary-800/50 dark:bg-primary-900/20 dark:text-primary-400">Who it's for</div>
      <p class="mt-4 text-3xl font-semibold leading-snug text-zinc-900 dark:text-white">
        Business Analysts & Product Managers who want to  manage  SDLC artefacts, at scale.
      </p>
      <ul class="mt-6 inline-block space-y-2 text-left text-base leading-relaxed text-zinc-700 dark:text-zinc-300">
        <li class="flex items-start gap-2"><span class="text-primary-600 dark:text-primary-400">✓</span><span>Writing BRDs, PRDs, and CRs by hand or with context-unaware LLMs</span></li>
        <li class="flex items-start gap-2"><span class="text-primary-600 dark:text-primary-400">✓</span><span>Checking Artefacts  against code, with full context</span></li>
        <li class="flex items-start gap-2"><span class="text-primary-600 dark:text-primary-400">✓</span><span>Clarifying Change Requests from clients, then sanity-checking them against the codebase</span></li>
        <li class="flex items-start gap-2"><span class="text-primary-600 dark:text-primary-400">✓</span><span>Assessing Bug reports and writing Test cases</span></li>
        <li class="flex items-start gap-2"><span class="text-primary-600 dark:text-primary-400">✓</span><span>Generating artefacts for AI powered Knowledge bases</span></li>
        <li class="flex items-start gap-2"><span class="text-primary-600 dark:text-primary-400">✓</span><span>Empowering Business Analysts to make use of version control for non-code artefacts</span></li>
      </ul>
    </div>
  </section>

  <!-- 3. Value proposition -->
  <section class="border-t border-zinc-200 py-20 dark:border-zinc-800">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl font-bold text-zinc-900 dark:text-white text-balance">Ask your Agent. Craft code-verified artefacts!</h2>
      <p class="mt-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
        Toss in  a raw client request — an email, Kanban Card, a Slack note, A Google Doc — and Baxter assists you in drafting  an  artefact, sanity checked against your actual code so you can review it. Every artefact is just Markdown in git, your whole team can work in git now: BAs and PMs review, comment, and approve requirements the same way developers review code.
      </p>
      <p class="mt-4 text-sm">
        <a href={`${base}philosophy/#sanity-check`} class="font-semibold text-primary-600 underline underline-offset-2 hover:text-primary-700 dark:text-primary-400">See how the multi-step sanity check works →</a>
      </p>
    </div>
  </section>

  <!-- 4. Get started in 3 steps -->
  <section class="border-t border-zinc-200 py-20 dark:border-zinc-800">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="text-center text-3xl font-bold text-zinc-900 dark:text-white">Get started in 3 simple steps</h2>

      <div class="mt-10 space-y-8">
        <div>
          <div class="flex items-center gap-3">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-600 text-sm font-bold text-white">1</span>
            <h3 class="font-semibold text-zinc-900 dark:text-white">Download the harness</h3>
          </div>
          <p class="mt-2 pl-11 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
            No git command needed. <a href="https://github.com/glovarix/agentic-ba/archive/refs/heads/main.zip" class="font-semibold text-primary-600 underline underline-offset-2 hover:text-primary-700 dark:text-primary-400">Download ZIP</a> and unzip it. (Prefer git? <code class="rounded bg-zinc-100 px-1 dark:bg-zinc-800">git clone</code> works too.)
          </p>
        </div>

        <div>
          <div class="flex items-center gap-3">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-600 text-sm font-bold text-white">2</span>
            <h3 class="font-semibold text-zinc-900 dark:text-white">Add your codebase — or any boilerplate you've got</h3>
          </div>
          <div class="mt-3 overflow-hidden rounded-lg border border-zinc-200 bg-zinc-950 dark:border-zinc-700">
            <pre class="p-3 text-sm text-zinc-300">cp -r /path/to/your/project coderepo/</pre>
          </div>
          <p class="mt-2 pl-0 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">Have real code? Drop it in as is. Nothing built yet? A starter boilerplate for your stack works too.</p>
        </div>

        <div>
          <div class="flex items-center gap-3">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-600 text-sm font-bold text-white">3</span>
            <h3 class="font-semibold text-zinc-900 dark:text-white">Open in your AI agent and paste a request — or just ask questions about your code</h3>
          </div>
          <p class="mt-2 pl-11 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">Claude Code, Cursor, and GitHub Copilot each pick up Baxter's instructions automatically and come alongside you.</p>
        </div>
      </div>

      <p class="mt-8 text-center text-sm">
        <a href={`${base}getting-started/`} class="font-semibold text-primary-600 underline underline-offset-2 hover:text-primary-700 dark:text-primary-400">Full setup guide →</a>
      </p>
    </div>
  </section>

  <!-- 5. Templated artefacts -->
  <section class="border-t border-zinc-200 bg-zinc-50 py-20 dark:border-zinc-800 dark:bg-zinc-900/50">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl font-bold text-zinc-900 dark:text-white">Templated artefacts</h2>
      <p class="mt-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
        Paste anything — no forms, no template names to remember. Core skills turn raw text into a verified, templated artefact:
      </p>
      <ul class="mt-5 flex flex-wrap items-center justify-center gap-2">
        {[
          'Requirements docs',
          'Product docs',
          'Implementation plans',
          'Test cases',
          'Bug reports',
          'Change requests',
          'AI feature specs',
          'Diagrams',
          'ER diagrams',
          'Clarification requests',
        ].map((artefact) => (
          <li class="whitespace-nowrap rounded-full border border-zinc-200 bg-white px-3 py-1 text-xs font-semibold text-zinc-700 sm:text-sm dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
            {artefact}
          </li>
        ))}
      </ul>
      <p class="mt-5 text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
        Because every one is a clean, structured Markdown file checked against your real code, you're not just filing tickets — you're building a consistent, AI-ready knowledge base of your product as a side effect.
      </p>
      <p class="mt-4 text-sm">
        <a href={`${base}docs/#templates`} class="font-semibold text-primary-600 underline underline-offset-2 hover:text-primary-700 dark:text-primary-400">See every template in detail →</a>
      </p>
    </div>
  </section>

  <!-- 6. Power skills — teaser -->
  <section class="border-t border-zinc-200 py-20 dark:border-zinc-800">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl font-bold text-zinc-900 dark:text-white">Power skills</h2>
      <p class="mt-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
        A set of slash commands in your Agentic setup to automate common things, for advanced users:
      </p>
      <ul class="mt-5 flex flex-wrap items-center justify-center gap-2">
        {[
          '/generate-module-registry',
          '/generate-role-registry',
          '/generate-retrospective-brd',
          '/generate-samples',
          '/generate-test-plan',
          '/generate-release-notes',
          '/compare-branches',
          '/validate-release',
          '/generate-ai-feature-registry',
          '/ai-feature-data-audit',
          '/generate-ai-feature-dependency-map',
          '/brainstorm-change',
          '/visualize-change',
        ].map((command) => (
          <li class="whitespace-nowrap rounded-full border border-zinc-200 bg-white px-3 py-1 font-mono text-xs font-semibold text-zinc-700 sm:text-sm dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
            {command}
          </li>
        ))}
      </ul>
      <p class="mt-5 text-sm">
        <a href={`${base}power-skills/`} class="font-semibold text-primary-600 underline underline-offset-2 hover:text-primary-700 dark:text-primary-400">Explore all power skills →</a>
      </p>
    </div>
  </section>

  <!-- 7. About the creator -->
  <section class="border-t border-zinc-200 bg-zinc-50 py-20 dark:border-zinc-800 dark:bg-zinc-900/50">
    <div class="mx-auto max-w-2xl px-6">
      <div class="flex flex-col items-center gap-4 text-center sm:flex-row sm:items-start sm:text-left">
        <img
          src={`${base}binu-alexander.png`}
          alt="Dr Binu Alexander"
          class="h-16 w-16 shrink-0 rounded-full object-cover"
        />
        <div>
          <h2 class="font-semibold text-zinc-900 dark:text-white">Dr Binu Alexander</h2>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Business Analyst, ASC · India</p>
          <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
            I am a Business Analyst and Consultant working at the intersection of Business Analysis, Healthcare Information Technology, Digital Transformation and Workplace Automation, and I run my practice from a base in India for clients across a range of regions and industries. Concerned that Business Analysts lacked working conditions available to developers, among them version control, plain-text documentation and peer review, I created the Agentic Business Analysis Framework to bring git and Markdown into Business Analysis practice, grounded in real code and supported by AI.
          </p>
          <p class="mt-3 text-sm">
            <a href={`${base}about/`} class="font-semibold text-primary-600 underline underline-offset-2 hover:text-primary-700 dark:text-primary-400">Full bio →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTA />

</Base>
