---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
const target = `${base}philosophy/#agentic-harness`;
---

<Base title="What is an Agentic Harness?" description="This content has moved to Philosophy." noindex={true}>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`${base}philosophy/`} />
  </Fragment>
  <div class="mx-auto max-w-lg px-6 py-24 text-center">
    <p class="text-zinc-600 dark:text-zinc-400">
      "What is an agentic harness?" now lives in <a href={target} class="font-semibold text-primary-600 underline underline-offset-2 hover:text-primary-700 dark:text-primary-400">Philosophy</a>. Redirecting…
    </p>
  </div>
</Base>
