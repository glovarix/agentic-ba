---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Share from '../components/Share.astro';

const base = import.meta.env.BASE_URL;

const projects = [
  {
    icon: '✨',
    name: 'Metaprompter',
    tagline: 'Structured prompt template framework',
    description: 'Takes your messy, one-off prompts and extracts the underlying template — converting them into structured JSON formats that can be saved and shared across teams and applications.',
    site: 'https://binu-alexander.github.io/metaprompter/',
    github: 'https://github.com/binu-alexander/metaprompter',
  },
  {
    icon: '🔀',
    name: 'fmRouter',
    tagline: 'AI playground and evals framework for FileMaker',
    description: 'Create, version, and compare prompts across multiple LLMs with LLM-as-Judge evaluation and full traceability — built natively in FileMaker 2025 without plugins.',
    site: 'https://glovarix.github.io/fmRouter/',
    github: 'https://github.com/glovarix/fmRouter',
  },
];
---

<Base title="About the Author" description="About Dr. Binu Alexander, creator of The Agentic BA — plus related tools from the same stable.">
  <div class="border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h1 class="text-4xl font-bold text-zinc-900 dark:text-white">About the Author</h1>
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-6 py-16">
    <div class="flex flex-col gap-6 rounded-xl border border-zinc-200 bg-white p-8 dark:border-zinc-800 dark:bg-zinc-900 sm:flex-row sm:items-start">
      <img
        src={`${base}binu-alexander.png`}
        alt="Dr. Binu Alexander"
        class="h-20 w-20 shrink-0 rounded-full object-cover"
      />
      <div>
        <div class="flex flex-wrap items-baseline gap-2">
          <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">Dr. Binu Alexander</h2>
          <a
            href="https://www.linkedin.com/in/drbinualexander/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-sm font-medium text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
        </div>
        <p class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400">Business Analyst, Alexander Software Consulting · India</p>
        <p class="mt-4 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
          Medical Doctor and Senior Technology Consultant with over 12 years of business analysis and product leadership — spanning healthcare, digital transformation, workplace automation and content localisation technology — bridging the gap between stakeholders and diverse technical teams. Binu holds certifications in Design Thinking, Apple's Claris FileMaker Platform and open source QGIS and PyQGIS, and specialises in delivering a variety of data-driven digital solutions. He has built and coached product leaders using an Agentic Business Analysis Framework (ABAF) which is an AI-powered agentic harness that enforces SDLC discipline at scale, running sanity checks for each artefact against live codebases and producing clinical-grade artefacts for product teams.
        </p>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-6 pb-16">
    <h2 class="mb-6 text-2xl font-bold text-zinc-900 dark:text-white">Other useful stuff to check out</h2>
    <div class="divide-y divide-zinc-100 dark:divide-zinc-800 rounded-xl border border-zinc-200 dark:border-zinc-800 overflow-hidden">
      {projects.map(p => (
        <div class="flex items-center gap-6 bg-white px-6 py-5 dark:bg-zinc-900">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-zinc-100 text-2xl dark:bg-zinc-800">
            {p.icon}
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-baseline gap-2">
              <span class="font-semibold text-zinc-900 dark:text-white">{p.name}</span>
              <span class="text-sm text-zinc-500 dark:text-zinc-400">{p.tagline}</span>
            </div>
            <p class="mt-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{p.description}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              <a
                href={p.site}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-lg bg-zinc-900 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-zinc-700 dark:bg-zinc-700 dark:hover:bg-zinc-600"
              >
                View Site
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
              </a>
              <a
                href={p.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-semibold text-zinc-700 transition-colors hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800"
              >
                <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                GitHub
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <Share />
  <CTA />
</Base>
