---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Share from '../components/Share.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="About" description="About Dr. Binu Alexander, creator of Baxter, the Agentic BA.">
  <div class="border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h1 class="text-3xl font-bold text-zinc-900 dark:text-white">About</h1>
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-6 py-16">
    <div class="flex flex-col gap-6 rounded-xl border border-zinc-200 bg-white p-8 dark:border-zinc-800 dark:bg-zinc-900 sm:flex-row sm:items-start">
      <img
        src={`${base}binu-alexander.png`}
        alt="Dr. Binu Alexander"
        class="h-20 w-20 shrink-0 rounded-full object-cover"
      />
      <div>
        <div class="flex flex-wrap items-baseline gap-2">
          <h2 class="text-3xl font-semibold text-zinc-900 dark:text-white">Dr. Binu Alexander</h2>
          <a
            href="https://www.linkedin.com/in/drbinualexander/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-sm font-semibold text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
        </div>
        <p class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400">Business Analyst, ASC · India</p>
        <div class="mt-4 space-y-4 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
          <p>
            Binu is a Business Analyst and Technology Consultant with over 12 years of experience in business analysis and product leadership globally. He runs his own software consulting practice from India, working across Healthcare IT, digital transformation, workplace automation, and content localisation technology.
          </p>
          <p>
            Binu started out in clinical medicine before moving into product building and the IT industry, holding leadership positions across a range of companies and domains. Along the way, as he picked up technical skills, he became frustrated that Business Analysts don't have the same tools developers take for granted — version control, plain-text artefacts, systematic peer review. He also wanted artefacts grounded in code: requirements checked against what's actually in the repo, not written in isolation. That's where the Agentic Business Analysis Framework came from.
          </p>
          <p>
            He's also been a hands-on developer — with significant work in Claris FileMaker Pro (Apple's low-code platform), and experience in JavaScript, SuiteScript, and Python for scripting and automation. He's the kind of BA who actually reads and sometimes writes code (now a lot with AI), rather than just handing requirements off to teams.
          </p>
          <p>
            He's coached product leaders and teams on applying AI to core Business Analysis skills. He loves parallel trench learning — digging deep into multiple domains at once and connecting the insights across them. His favourite book is <em>Range</em> by David Epstein, which champions generalists and broad exploration over narrow specialisation.
          </p>
          <p>
            Want to chat about ABAF or anything else? Drop him an email at <a href="mailto:binu@thedatadrivenlife.com" class="font-semibold text-primary-600 underline underline-offset-2 hover:text-primary-700 dark:text-primary-400">binu@thedatadrivenlife.com</a>.
          </p>
        </div>
      </div>
    </div>
  </div>

  <Share />
  <CTA />
</Base>
