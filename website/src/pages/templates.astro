---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
const target = `${base}docs/#templates`;
---

<Base title="Templates" description="Templates have moved to Documentation." noindex={true}>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`${base}docs/`} />
  </Fragment>
  <div class="mx-auto max-w-lg px-6 py-24 text-center">
    <p class="text-zinc-600 dark:text-zinc-400">
      Templates now live in <a href={target} class="font-medium text-primary-600 underline underline-offset-2 hover:text-primary-700 dark:text-primary-400">Documentation</a>. Redirecting…
    </p>
  </div>
</Base>
