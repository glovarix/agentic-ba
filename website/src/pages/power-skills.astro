---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CTA from '../components/CTA.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="Power Skills" description="Thirteen slash-command automation workflows for Baxter — module and role registries, release notes, release validation, branch comparisons, AI feature review, and more.">
  <PageHeader
    title="Power skills — slash commands"
    description="Core skills are templated artefacts you invoke by pasting raw text. Power skills are thirteen automation workflows you run explicitly as slash commands."
  />

  <div class="mx-auto max-w-5xl px-6 pt-8">
    <a href={`${base}docs/`} class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600 hover:text-primary-700 dark:text-primary-400">← Back to Docs</a>
  </div>

  <div class="mx-auto max-w-5xl px-6 py-16">
    <p class="text-sm text-zinc-600 dark:text-zinc-400">
      Each confirms before saving and exports a PDF automatically where applicable; the full output structure lives in each command file in <code class="rounded bg-zinc-100 px-1 dark:bg-zinc-800">.claude/commands/</code>.
    </p>
    <div class="mt-6 overflow-x-auto rounded-xl border border-zinc-200 dark:border-zinc-700">
      <table class="w-full text-sm">
        <thead class="border-b border-zinc-200 bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900">
          <tr>
            <th class="px-4 py-3 text-left font-semibold text-zinc-900 dark:text-white">Command</th>
            <th class="px-4 py-3 text-left font-semibold text-zinc-900 dark:text-white">What it's for</th>
            <th class="px-4 py-3 text-left font-semibold text-zinc-900 dark:text-white">What you provide</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
          {[
            { cmd: '/generate-module-registry', use: 'Builds the module registry Baxter checks module names against in every artefact — folding submodules, CRUD actions, dashboards, and standalone AI features into their parent module, with each module\'s filename slug included.', provide: 'Nothing — just run it. Optionally point it at other reference material (notes, a spreadsheet, a prior registry) to reconcile in too. Writes artefacts/module-registry/modules.md.' },
            { cmd: '/generate-role-registry', use: 'Builds the role registry Baxter checks role names against in every artefact that says who can do what. Reads the codebase\'s access model — role definitions, seed data, permission enforcement, role-based UI branching, the role-management screen — and lists each built-in role with its code identifier, scope, and out-of-the-box access. Customer-created custom roles, permissions, job titles held as data, account states, service accounts, and subscription tiers are excluded, and the exclusions are recorded in the file rather than dropped silently.', provide: 'Nothing — just run it. It needs a codebase and has no other source: a BRD or a permissions spreadsheet cannot stand in, so with an empty coderepo/ it stops rather than guessing. Writes artefacts/role-registry/roles.md and context/roles.md.' },
            { cmd: '/generate-test-plan', use: 'Synthesises a full, structured test plan from a module\'s saved test cases, plus PDF, written to test-plans/{MODULE}/. Requires test cases first — Baxter mentions the option once they are saved, never runs it automatically.', provide: 'A module with test cases in test-cases/{MODULE}/, or pick one when prompted.' },
            { cmd: '/generate-release-notes', use: 'Pre-release notes grouped by module, plus PDF, written to release-notes/. Adds issue and tracker links for whichever integrations are enabled.', provide: 'A sprint number and the issue numbers to include.' },
            { cmd: '/validate-release', use: 'Confirms every release-note item is on staging, flags undocumented changes and DB migrations, plus PDF.', provide: 'Release notes (from release-notes/, or any path), two branch snapshots in coderepo/branches/, and a sprint number.' },
            { cmd: '/compare-branches', use: 'Diffs two branch snapshots — technical, plain-English, or both — plus PDF, written to branch-comparisons/.', provide: 'Two branch folders in coderepo/branches/ (folder name becomes the label).' },
            { cmd: '/generate-retrospective-brd', use: 'Reads a codebase and drafts a client-facing BRD — modules, roles and personas, the Who/Why/What, and each module\'s high-level features, every module marked Existing. Standalone: no PRD, CR, or module registry required. The document says on its face that it was derived from code, so it is never confused with a BRD written before the build.', provide: 'A codebase folder path — or nothing, to use coderepo/. Writes artefacts/business-requirements/{date}-{product}-retrospective-BRD.md.' },
            { cmd: '/generate-samples', beta: true, use: 'Realistic sample data records derived entirely from your real schema and lookup values.', provide: 'Nothing — add a number 1–3 for more records. Writes JSON to artefacts/sample-data/.' },
            { cmd: '/generate-ai-feature-registry', use: 'Works out where AI lives in your codebase — model clients, prompts, feature flags — then drafts a registry of every AI feature: trigger, code location, flag, status. No assumed folder layout.', provide: 'Nothing — just run it. Writes artefacts/product-documentation/ai-feature-review/ai-features.md.' },
            { cmd: '/ai-feature-data-audit', use: 'Traces exactly what data feeds one AI feature — tables, fields, filters — plus a QA testing guide.', provide: 'The AI feature name. Presented in the response; saved only if you ask.' },
            { cmd: '/generate-ai-feature-dependency-map', use: 'Maps which product modules each AI feature depends on, and the impact if one is disabled.', provide: 'Nothing — just run it (or name a feature).' },
            { cmd: '/brainstorm-change', use: 'A second-opinion sweep on a CR in any state: cross-module ripple effects, recurring patterns elsewhere in the app, alternative implementations, and UX ideas.', provide: 'A CR name or path — or none, for a CR still being discussed or drafted in the current conversation.' },
            { cmd: '/visualize-change', use: 'A single self-contained, clickable HTML prototype demonstrating a CR\'s behaviour, grounded in the real product — not a design deliverable.', provide: 'A CR name, path, or "this" for the CR being drafted in the current conversation. Writes to artefacts/change-visualisations/.' },
          ].map((row) => (
            <tr class="bg-white dark:bg-zinc-950">
              <td class="px-4 py-3 align-top whitespace-nowrap">
                <span class="font-mono text-sm text-violet-700 dark:text-violet-400">{row.cmd}</span>
                {row.beta && (
                  <span class="ml-2 rounded-full border border-amber-300 bg-amber-100 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-700 dark:border-amber-700/50 dark:bg-amber-900/30 dark:text-amber-400">Beta</span>
                )}
              </td>
              <td class="px-4 py-3 align-top text-zinc-600 dark:text-zinc-400">{row.use}{row.beta && <span class="text-zinc-400 dark:text-zinc-500"> (experimental)</span>}</td>
              <td class="px-4 py-3 align-top text-zinc-500 dark:text-zinc-400">{row.provide}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <CTA />
</Base>
