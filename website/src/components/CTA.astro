---
const base = import.meta.env.BASE_URL;
---

<section class="border-t border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="relative overflow-hidden rounded-2xl bg-zinc-900 px-8 py-16 text-center dark:bg-zinc-800/50 dark:ring-1 dark:ring-zinc-700">
      <div class="absolute inset-0 -z-10">
        <div class="absolute left-1/4 top-0 h-[300px] w-[300px] rounded-full bg-primary-600/20 blur-3xl"></div>
        <div class="absolute bottom-0 right-1/4 h-[300px] w-[300px] rounded-full bg-primary-400/10 blur-3xl"></div>
      </div>

      <div class="mb-4 flex items-center justify-center gap-2.5">
        <span class="inline-flex items-center justify-center rounded-lg bg-primary-600 px-3 py-1.5 text-sm font-bold text-white">
          Baxter
        </span>
        <span class="text-sm font-semibold text-white">The Agentic BA</span>
      </div>
      <h2 class="text-3xl font-bold tracking-tight text-white">
        Ready to work with Baxter?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-zinc-400">
        Open source and free. Drop the harness into any project, open it in Claude Code, Cursor, or GitHub Copilot, and paste your first raw request.
      </p>

      <div class="mt-8 flex justify-center">
        <a
          href={`${base}getting-started/`}
          class="inline-flex items-center justify-center rounded-lg bg-primary-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:bg-primary-700"
        >
          Get Started
          <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
