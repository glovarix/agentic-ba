---
const base = import.meta.env.BASE_URL;
---

<section class="relative overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-0 h-[700px] w-[700px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary-500/10 blur-3xl dark:bg-primary-500/5"></div>
    <div class="absolute right-0 top-1/3 h-[400px] w-[400px] rounded-full bg-primary-400/10 blur-3xl dark:bg-primary-400/5"></div>
  </div>

  <div class="mx-auto max-w-6xl px-6 pb-24 pt-24 sm:pt-36">
    <div class="mx-auto max-w-4xl text-center">

      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">
        Meet Baxter, the Agentic BA !
      </h1>

      <a
        id="hero-release"
        href="https://github.com/glovarix/agentic-ba/releases/latest"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 hidden items-center gap-2 rounded-full border border-zinc-200 bg-white px-4 py-1.5 text-sm text-zinc-700 transition-colors hover:border-primary-300 hover:text-primary-700 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-primary-700 dark:hover:text-primary-400"
        aria-label="Latest release"
      >
        <span class="rounded-full bg-primary-600 px-2 py-0.5 text-xs font-semibold text-white">Latest release</span>
        <span id="hero-release-text"></span>
      </a>

      <p class="mx-auto mt-8 max-w-2xl text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
        A Business analysis Copilot — essentially a plain-text harness , that works alongside you to craft markdown artefacts and verify business requirements, change requests, bug reports, and other key SDLC artefacts against your real codebase, right inside an AI coding IDE.
      </p>

      <div class="mt-8 inline-flex items-center gap-2 rounded-full border border-primary-200 bg-primary-50 px-4 py-1.5 text-sm font-semibold text-primary-700 dark:border-primary-800/50 dark:bg-primary-900/20 dark:text-primary-400">
        No vendor lock-in - Works in any AI IDE, e.g., Claude Code, Cursor or GitHub Copilot
      </div>

      <div class="mt-6 flex justify-center">
        <a href={`${base}getting-started/`} class="inline-flex items-center justify-center rounded-lg bg-primary-600 px-8 py-4 text-base font-semibold text-white shadow-sm transition-all hover:bg-primary-700 hover:shadow-md">
          Get Started with Baxter
          <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  (async () => {
    const link = document.getElementById('hero-release');
    const text = document.getElementById('hero-release-text');
    if (!link || !text) return;
    try {
      const res = await fetch('https://api.github.com/repos/glovarix/agentic-ba/releases/latest');
      if (!res.ok) return;
      const data = await res.json();
      if (data.name && data.html_url) {
        text.textContent = data.name;
        link.setAttribute('href', data.html_url);
        link.classList.remove('hidden');
        link.classList.add('inline-flex');
      }
    } catch {
      // No network or rate-limited: keep the line hidden rather than show stale information
    }
  })();
</script>
